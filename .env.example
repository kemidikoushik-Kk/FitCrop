# FitCorp Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Application Profile: dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitcorp
DB_USERNAME=fitcorp_user
DB_PASSWORD=fitcorp_secure_pass_2026

# JWT Security Configuration
# Must be at least 256-bit (32+ characters) hex/base64 or random string
JWT_SECRET=4c5a782b3d9e8f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server & CORS
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Application Timezone
APP_TIMEZONE=Asia/Kolkata

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8080/api/v1
